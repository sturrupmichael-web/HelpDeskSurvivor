{
  "name": "helpdesk-survivors",
  "private": true,
  "type": "module",
  "description": "A survivors-like about working the IT helpdesk. No runtime dependencies (esbuild, Playwright and ESLint are for building, testing and checking).",
  "scripts": {
    "sprites": "node sprites/build.js",
    "serve": "python3 -m http.server 8000",
    "build": "node build.mjs",
    "build:preview": "node build.mjs --preview",
    "test": "node tests/run.mjs",
    "site": "node site.mjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "playwright": "1.64.1"
  }
}
